<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keep excluding these even if allowBackup is later flipped. D2D ignores allowBackup on API 31+. -->
    <cloud-backup>
        <exclude domain="file" path="credentials/" />
        <exclude domain="file" path="drafts/" />
        <exclude domain="file" path="journal/" />
        <exclude domain="file" path="workspaces/" />
        <exclude domain="file" path="environment/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="credentials/" />
        <exclude domain="file" path="drafts/" />
        <exclude domain="file" path="journal/" />
        <exclude domain="file" path="workspaces/" />
        <exclude domain="file" path="environment/" />
    </device-transfer>
</data-extraction-rules>
