# Gradle
.gradle/
build/
**/build/

# The on-device BUILD sources live under a directory whose name contains
# "build". Keep its source tree versioned while retaining the generated
# Gradle outputs below it as ignored files.
!ondevice-build/
!ondevice-build/*/
!ondevice-build/*/src/
!ondevice-build/*/src/**
/ondevice-build/*/build/
/ondevice-build/*/bin/

# Kotlin
.kotlin/

# Local SDK / IDE
local.properties
*.iml
.idea/
.vscode/
*.swp

# Android
captures/
.externalNativeBuild/
.cxx/
output.json
*.apk
*.aar
*.ap_
*.aab
*.dex
bin/
gen/
out/

# Secrets — never commit keys or debug overlays
secrets.properties
*.jks
*.keystore
!debug.keystore

# OS / misc
.DS_Store
*.log
*.hprof
*.orig
*~

# Do not ignore repo-root icon.png (canonical Clanker art)
